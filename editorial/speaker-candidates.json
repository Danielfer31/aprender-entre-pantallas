        "hector"
      ],
      "reviewStatus": "pending",
      "reviewer": "",
      "reviewedAt": null,
      "sourceTurnIds": [
        "turn-009"
      ],
      "text": "Una narrativa transmedia no consiste simplemente en repetir el mismo mensaje en varias plataformas.",
      "sourceSegment": 15,
      "cutCrossing": false
    },
    {
      "start": 93.62,
      "end": 100.62,
      "kind": "unknown",
      "speakerIds": [],
      "suggestedSpeakerIds": [
        "hector"
      ],
      "reviewStatus": "pending",
      "reviewer": "",
      "reviewedAt": null,
      "sourceTurnIds": [
        "turn-025"
      ],
      "text": "Henry Jenkins explica en su artículo 2007 que cada medio puede aportar una parte distinta",
